pub fn main() -> i32 {
    let parsed = match "42".to_int() {
        Ok(value) => value,
        Err(_) => 0,
    }
    let rejects_text = match "x".to_int() {
        Ok(_) => false,
        Err(_) => true,
    }
    let rejects_overflow = match "2147483648".to_int() {
        Ok(_) => false,
        Err(_) => true,
    }
    let max: i32 = 2147483647
    let overflows = match max.checked_add(1) {
        Ok(_) => false,
        Err(_) => true,
    }
    let fits = match max.checked_sub(2147483647) {
        Ok(value) => value == 0,
        Err(_) => false,
    }
    let wrapped = max.wrapping_add(1) < 0
    if parsed == 42 && rejects_text && rejects_overflow && overflows && fits && wrapped {
        return 1
    }
    return 0
}
