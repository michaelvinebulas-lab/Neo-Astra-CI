pub fn main() -> i32 {
    let mut total = 0
    for value in [1, 2, 3, 4, 5] {
        total = total + value
    }
    println(total)

    let mut index = 0
    while index < 3 {
        index = index + 1
    }
    println(index)

    if total > 10 {
        println("large")
    } else {
        println("small")
    }
    return 0
}
