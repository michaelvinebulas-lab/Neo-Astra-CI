pub fn main() -> i32 {
    let text = "héllo"
    let mid = match text.slice(1, 3) {
        Ok(piece) => piece == "é",
        Err(_) => false,
    }
    let out_of_bounds = match text.slice(0, 99) {
        Ok(_) => false,
        Err(_) => true,
    }
    let reversed = match text.slice(3, 1) {
        Ok(_) => false,
        Err(_) => true,
    }
    let split = match text.slice(1, 2) {
        Ok(_) => false,
        Err(_) => true,
    }
    let buffer = b"abcdef"
    let part = buffer.slice(1, 3)
    let bytes_ok = part.len() == 2 && part[0] == 98
    if mid && out_of_bounds && reversed && split && bytes_ok {
        return 1
    }
    return 0
}
