// edition: 0.2
// purpose: trailing commas in every comma-separated list

struct Pair<T, U,> {
    first: T,
    second: U,
}

enum Maybe<T,> {
    Just(T,),
    Nothing,
}

fn choose<T,>(value: T,) -> T {
    return value
}

pub fn main() -> i32 {
    let pair = Pair::<i32, i32,> { first: 1, second: 2, }
    let values = [1, 2, 3,]
    let table = {"a": 1, "b": 2,}
    let maybe: Maybe<i32,> = Just::<i32,>(choose::<i32,>(1,))
    match maybe {
        Just(value) => return pair.first + pair.second + value + table["a"] + values[0],
        Nothing => return 0,
    }
}
